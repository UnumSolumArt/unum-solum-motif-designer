# URL du serveur Rhino Compute.
# - Dev local : http://localhost:5000
# - Prod (post-tunnel) : URL Cloudflare Tunnel ou IP du VPS Windows
RHINO_COMPUTE_URL=http://localhost:5000

# Clé API Rhino Compute (header RhinoComputeKey).
# Laisser vide si le serveur Compute est lancé sans clé en local.
RHINO_COMPUTE_KEY=
